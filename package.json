{
  "name": "hf-jb",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite -c blue,magenta \"tsx watch server/dev.ts\" \"vite\"",
    "api": "tsx server/dev.ts",
    "client": "vite",
    "sync": "node scripts/sync-scaffold.mjs && node scripts/sync-skill.mjs",
    "prebuild": "npm run sync",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx server/smoke.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/react": "latest",
    "@hono/node-server": "^2.0.5",
    "@hyperframes/core": "^0.9.19",
    "@hyperframes/lint": "0.9.19",
    "@hyperframes/parsers": "0.9.19",
    "@hyperframes/player": "0.9.19",
    "ai": "latest",
    "bash-tool": "latest",
    "dotenv": "^18.0.9",
    "hono": "^4.0.0",
    "just-bash": "latest",
    "linkedom": "^0.18.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
