{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "headers": [{ "source": "/vfs-sw.js", "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }] }]
}
